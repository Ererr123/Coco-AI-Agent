# (Comments must be on their own line: git treats a trailing "# ..." as part of the pattern.)

# ---- Personal data: never commit ----
# Run logs contain everything typed into the agent (also logs/mcp-servers.log)
logs/
# The agent's notes folder
notes/
# Long-term memory: your preferences, facts and decisions
memory.md
# The agent's personality
persona*.md
# Your own MCP server additions (may name accounts or repos; tokens go in environment variables)
src/loop/mcp_servers.local.json
# Secrets, if you ever keep any in a file
.env
*.token
credentials*.json

# ---- Downloaded tools and models (large binaries, re-downloadable) ----
# llama.cpp release folder, e.g. llama-b12321-bin-win-vulkan-x64/
/llama-*/
*.gguf

# ---- Generated by running things ----
# Eval run results: per-machine history used for "vs. previous run" comparisons
src/loop/eval_results/
src/loop/speed_results/
src/loop/voice_results/
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
node_modules/

# Downloaded MCP server binaries (e.g. tools/github-mcp-server/). The scripts and notebook here are ours: tracked
/tools/*
!/tools/*.py
!/tools/*.ipynb

# Downloaded models (speech etc.): large, re-downloadable
models/
